# Track all large files with LFS
*.npy filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
# Specific paths (adicione seus paths reais)
data/v3/processed/*.npy filter=lfs diff=lfs merge=lfs -text
data/v3/processed/*.pkl filter=lfs diff=lfs merge=lfs -text
